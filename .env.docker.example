# docker compose 用の設定。
#
#   cp .env.docker.example .env
#   docker compose up --build
#
# 鍵の作り方（50文字以上が必要）:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 必須 ---------------------------------------------------------------
DJANGO_SECRET_KEY=ここに50文字以上の乱数を入れる
POSTGRES_PASSWORD=ここにDBのパスワードを入れる

# --- 公開先 -------------------------------------------------------------
# 実際のドメインに変える。ここに無いホスト名では応答しない。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 画面から見たAPIの場所。空にすると、表示中のホストの8000番へ向く。
VITE_API_BASE_URL=

# 確認メールと再設定メールのリンクの行き先。本番では必須（未設定だと起動しない）
FRONTEND_URL=http://localhost:5173

# --- メール -------------------------------------------------------------
# 送るのは3通だけ。メールの確認 / パスワードの再設定 / 登録完了のお知らせ。
# 開発ではコンソールへ出す。本番は smtp を指定し、宛先サーバーと
# 差出人を必ず入れる（入れないと起動時に止まる）。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AIPPO <no-reply@localhost>

# --- 外部サービスでのログイン -------------------------------------------
# 鍵を入れた先だけボタンが出る。戻り先を向こうの管理画面へ登録すること。
#   <BACKEND_URL>/api/v1/accounts/social/{google,line}/callback/
# BACKEND_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINE_CLIENT_ID=
# LINE_CLIENT_SECRET=

# --- AI -----------------------------------------------------------------
# 開発とテストは mock。外部へ出ず、決定論的に答える。
# 本番で openai / anthropic を指定したのに鍵が無いときは、黙って mock へ
# 倒さずはっきり失敗させる。偽物の答えを本物として見せるほうが害が大きい。
AI_PROVIDER=mock
AI_MODEL=gpt-5-nano
# OPENAI_API_KEY=sk-...

# 1回の呼び出しの上限
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600

# 1日に実行できる回数。0以下で「上限なし」
AI_DAILY_REQUEST_LIMIT_GUEST=10
AI_DAILY_REQUEST_LIMIT_USER=50

# 利用者が貼った本文を DB に保存するか。
# 既定は保存しない。調べたいときだけ true にする。
AI_STORE_RAW_INPUT=false

# ANTHROPIC_API_KEY=

# --- AI利用料の上限 -----------------------------------------------------
# セッション上限だけでは Cookie を消して回避できるため、
# 接続元単位と全体の1日あたり上限で止める。0以下は「上限なし」。
# 目安: レッスン1本の完走に必要なAI実行は 10〜12回。
MAX_ATTEMPTS_PER_SESSION=10
AI_RUNS_PER_IP_PER_DAY=100
AI_RUNS_PER_DAY=2000

# --- 画像の上限（文章とは別枠） -----------------------------------------
# 画像1枚は文章1回の数十倍かかる。文章の枠をそのまま使うと、
# 100回が画像100枚を許すことになり、1日の請求が桁で変わる。
# 混ぜないのは費用のためだけではない——画像を数枚作った人が、その日の
# 文章のレッスンまで使えなくなるのを避けるため。
#
# 数の目安: 画像のレッスンは1本で最低3枚
# （最初の1枚＋条件を足した1枚＋自分の課題で1枚）。
# 実際の単価が分かったら、1日に許してよい金額から逆に決めること。
#
# **0以下（上限なし）にしないこと。** 歯止めが外れる。
AI_IMAGE_RUNS_PER_IP_PER_DAY=20
AI_IMAGE_RUNS_PER_DAY=200
AI_IMAGE_DAILY_REQUEST_LIMIT_GUEST=3
AI_IMAGE_DAILY_REQUEST_LIMIT_USER=8

# --- 前段にロードバランサを置くとき -------------------------------------
# true にすると X-Forwarded-For を接続元として信じる。
# 直接公開している状態で true にすると、詐称して上限を回避できてしまう。
TRUST_FORWARDED_FOR=false

# 実際に公開するときは true（HTTPSへ転送する）。
# 手元で本番の姿のまま確認する間だけ false。
SECURE_SSL_REDIRECT=false

# --- DB -----------------------------------------------------------------
POSTGRES_DB=aippo
POSTGRES_USER=aippo

# --- 見張り -------------------------------------------------------------
# 任意。空なら何も読み込まない。本文は送らない設定で初期化する。
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
