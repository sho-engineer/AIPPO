# docker compose 用の設定。
#
#   cp .env.docker.example .env
#   docker compose up --build
#
# 鍵の作り方（50文字以上が必要）:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 必須 ---------------------------------------------------------------
DJANGO_SECRET_KEY=ここに50文字以上の乱数を入れる
POSTGRES_PASSWORD=ここにDBのパスワードを入れる

# --- 公開先 -------------------------------------------------------------
# 実際のドメインに変える。ここに無いホスト名では応答しない。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 画面から見たAPIの場所。空にすると、表示中のホストの8000番へ向く。
VITE_API_BASE_URL=

# --- AI -----------------------------------------------------------------
# stub のままでもレッスンは完走できる（憲章 原則 III）。
# 本物を使うときだけ anthropic に変えて、鍵を入れる。
AI_PROVIDER=stub
AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- AI利用料の上限 -----------------------------------------------------
# セッション上限だけでは Cookie を消して回避できるため、
# 接続元単位と全体の1日あたり上限で止める。0以下は「上限なし」。
# 目安: レッスン1本の完走に必要なAI実行は 10〜12回。
MAX_ATTEMPTS_PER_SESSION=10
AI_RUNS_PER_IP_PER_DAY=100
AI_RUNS_PER_DAY=2000

# --- 前段にロードバランサを置くとき -------------------------------------
# true にすると X-Forwarded-For を接続元として信じる。
# 直接公開している状態で true にすると、詐称して上限を回避できてしまう。
TRUST_FORWARDED_FOR=false

# 実際に公開するときは true（HTTPSへ転送する）。
# 手元で本番の姿のまま確認する間だけ false。
SECURE_SSL_REDIRECT=false

# --- DB -----------------------------------------------------------------
POSTGRES_DB=aippo
POSTGRES_USER=aippo
