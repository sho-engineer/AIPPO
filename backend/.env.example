# AIPPO バックエンドの設定。
#
#   cp .env.example .env
#
# ここに実際の値を書かない。このファイルはリポジトリに入る。
# 鍵の作り方（50文字以上が必要）:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Vercel（Services 構成）へ出すときに、Vercel の Environment Variables へ
# 入れる値は docs/deploy-vercel.md にまとめてある。このファイルは手元用。

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- データベース -------------------------------------------------------
# 未設定なら SQLite。本番はここに PostgreSQL の接続先を入れる。
# DATABASE_URL=postgres://user:pass@localhost:5432/aippo
#
# Vercel では SQLite は使えない。実行のたびに使い捨てのファイル環境になるので、
# 登録も進捗も次の要求では消えている。必ず外部の PostgreSQL を繋ぐこと
# （Vercel Marketplace の Neon など）。繋ぐと DATABASE_URL が自動で入る。

# --- 画面の場所 ---------------------------------------------------------
# 確認メールと再設定メールのリンクがここへ向く。
# 本番では必須（未設定だと起動しない）。
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 画面と API が別ホストのときだけ。空なら CORS_ALLOWED_ORIGINS と同じ。
# CSRF_TRUSTED_ORIGINS=

# --- ログイン状態の持ち方 -----------------------------------------------
# 合言葉は Cookie にしか置かない。画面へは渡さない。
# 画面と API が別サイト（別ドメイン）なら None にし、HTTPS も必須になる。
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# ログインの期限は2つ。どちらか早いほうで切れる。
#
#   SESSION_COOKIE_AGE        触らないまま何秒で切れるか（30日）
#   SESSION_ABSOLUTE_MAX_AGE  ログインした日から何秒で切れるか（90日）
#
# 1つ目だけだと、要求のたびに期限が先へ延びる（SESSION_SAVE_EVERY_REQUEST）
# ので、開き続けている人はいつまでもログインしたままになる。
# 端末を手放したあとや、こちらの都合で切りたい場面のために2つ目を置いている。
# 2つ目を 0 以下にすると上限そのものが外れる（勧めない）。
SESSION_COOKIE_AGE=2592000
SESSION_ABSOLUTE_MAX_AGE=7776000

# --- メール -------------------------------------------------------------
# 送るのは3通だけ。メールの確認 / パスワードの再設定 / 登録完了のお知らせ。
#
# 開発ではコンソールへ出す（実際には送らない）。
# 本番は smtp を明示し、EMAIL_HOST と DEFAULT_FROM_EMAIL を必ず入れる。
# 入れないと起動時に止まる。送れないまま登録を開くと、確認も再設定も
# できない人がそのまま溜まっていくため。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# 587 は TLS、465 は SSL。両方 true にすると起動しない
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=AIPPO <no-reply@localhost>

# --- パスキー（WebAuthn）------------------------------------------------
# 合言葉を覚えなくてよくする仕組み。指紋や顔で本人を確かめ、端末が持つ
# 秘密鍵で署名する。こちらが預かるのは公開鍵だけ。
#
# 署名にはドメインが混ざる。だから偽サイトで作らせた署名は本物の
# ドメインでは通らない。ここを取り違えると、その守りが丸ごと外れる。
#
# 未設定なら FRONTEND_URL から決まる（手元はそれで足りる）。
#   PASSKEY_RP_ID   ドメイン。ポートを含めない。例）aippo.vercel.app
#   PASSKEY_ORIGINS 署名を受け付ける送り元。scheme とポートまで含む。カンマ区切り
#   PASSKEY_RP_NAME 端末の画面に出るサービス名
#
# パスキーは https が要る（localhost だけ http でも使える）。
# PASSKEY_RP_ID=
# PASSKEY_ORIGINS=
# PASSKEY_RP_NAME=AIPPO

# --- 外部サービスでのログイン -------------------------------------------
# 鍵を入れた先だけ、画面にボタンが出る。入れなければ出ない。
#
# 向こうの管理画面には、戻り先として次を登録する。
#   <BACKEND_URL>/api/v1/accounts/social/google/callback/
#   <BACKEND_URL>/api/v1/accounts/social/line/callback/
#
# BACKEND_URL が空なら、要求から組み立てる（手元はそれで足りる）。
# ロードバランサ配下では実際の公開先とずれることがあるので、本番では入れる。
# BACKEND_URL=https://api.example.com

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LINE はメールを既定では返さない（申請が要る）。
# 返らなくてもログインはできる（メールの無いアカウントになる）。
# LINE_CLIENT_ID=
# LINE_CLIENT_SECRET=

# --- 認証の連打を止める -------------------------------------------------
# 接続元（SOURCE）と、狙われている宛先（TARGET）の両方で数える。
# 接続元のほうを緩くしてある。会社や学校からは何人もが同じ接続元に見えるので、
# 同じ厳しさにすると、隣の席の人が数回試しただけで全員が締め出される。
# 0以下で「上限なし」。手元の確認や負荷試験のときだけ外す。
AUTH_THROTTLE_SIGNIN_MAX_SOURCE=30
AUTH_THROTTLE_SIGNIN_MAX_TARGET=10
AUTH_THROTTLE_SIGNIN_WINDOW=900
AUTH_THROTTLE_PASSWORD_RESET_MAX_SOURCE=20
AUTH_THROTTLE_PASSWORD_RESET_MAX_TARGET=5
AUTH_THROTTLE_PASSWORD_RESET_WINDOW=3600
AUTH_THROTTLE_SIGNUP_MAX_SOURCE=10
AUTH_THROTTLE_SIGNUP_WINDOW=3600

# --- AI プロバイダ ------------------------------------------------------
# 開発とテストは mock。外部へ出ず、決まった答えを返すので、
# 鍵が無くても教材9本を最後まで完走できる（憲章 原則 III）。
#
# 本番で gemini / openai / anthropic を指定したのに鍵が無いときは、
# 黙って mock へ倒さずはっきり失敗させる（503 AI_SERVICE_NOT_CONFIGURED）。
# 偽物の答えを本物として学習者に見せるほうが害が大きい。
#
# コード側の既定は gemini（費用・無料枠の都合）。ただし Gemini の
# Free Tier はユーザーの入力が学習に使われうる契約。本番でユーザーの
# 仕事の文章・機密情報・個人情報を扱うときは、必ず Paid Tier
# （学習利用しない契約条件）の鍵を使うこと。openai / anthropic は
# 本番でも使える（比較・切り替え先として残してある）。
AI_PROVIDER=mock
AI_MODEL=gpt-5-nano
AI_MODEL_GEMINI=gemini-2.5-flash
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 1回の呼び出しの上限
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_INPUT_CHARACTERS=5000

# 1日に実行できる回数。0以下で「上限なし」
AI_DAILY_REQUEST_LIMIT_GUEST=10
AI_DAILY_REQUEST_LIMIT_USER=50

# 利用者が貼った本文を DB に保存するか。
# 既定は保存しない。調べたいときだけ true にする。
AI_STORE_RAW_INPUT=false

# --- AI利用料の上限 -----------------------------------------------------
# セッション単位の上限だけでは足りない。learner_key は Cookie なので、
# 消せば毎回まっさらなセッションになる。接続元単位と全体でも止める。
# 目安: レッスン1本の完走に必要なAI実行は 10〜12回。
MAX_ATTEMPTS_PER_SESSION=10
AI_RUNS_PER_IP_PER_DAY=100
AI_RUNS_PER_DAY=2000

# --- 前段にロードバランサを置くとき -------------------------------------
# true にすると X-Forwarded-For を接続元として信じる。
# 直接公開している状態で true にすると、詐称して上限を回避できてしまう。
TRUST_FORWARDED_FOR=false
# 実際に公開するときは true（HTTPSへ転送する）
SECURE_SSL_REDIRECT=false

# --- 管理画面の守り -----------------------------------------------------
# 管理画面の向こうには、実証実験で集めた全学習者の記録がある。
# いま間にあるのは合言葉ひとつだけなので、守りを2枚足せるようにしてある。
# どちらも未設定なら今までどおり `/admin/` が誰からでも開く（手元用）。
#
# 1) 場所を変える。総当たりは `/admin/` を狙うので、違う場所なら届かない。
#    先頭・末尾の / は付けても付けなくてもよい。
#    Vercel では vercel.json の rewrites にも同じパスを足すこと
#    （足さないと画面側へ振り分けられて 404 になる）。
# DJANGO_ADMIN_PATH=admin/
#
# 2) 入れる接続元を絞る（カンマ区切り）。合言葉が漏れても、
#    ここに無い場所からは入り口に届かない。当たったときは 403 ではなく
#    404 を返す（403 だと「そこに管理画面がある」と教えてしまう）。
#    前段にロードバランサがあるときは TRUST_FORWARDED_FOR=true も要る。
# DJANGO_ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.4

# --- 保存する期間 -------------------------------------------------------
# 登録していない人の記録を、最後の利用から何日残すか。
# プライバシーポリシーに書いた期間と揃える（食い違えば、それは嘘になる）。
# 消すのは `manage.py prune_data`。1日1回動かす。
#
# ゲストの Cookie は7日で切れる。それを過ぎると本人からも取り出せない
# 記録になるので、そこから長く持っても、持っているのはこちらの都合だけ。
GUEST_DATA_RETENTION_DAYS=30

# 定期実行から prune_data を叩くための合言葉。
# 入れると POST /api/v1/maintenance/prune/ が開く。
# **空のあいだ、その入り口は 404 で存在しない**（入れ忘れた配置で
# 「誰でも全データを消せる URL」が開かないように、そちらへ倒してある）。
#
# 作り方:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Vercel では、この名前で入れておくと Cron からの要求に
# `Authorization: Bearer <CRON_SECRET>` が自動で付く。
# 手元で試すときは自分で付ける:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     http://localhost:8000/api/v1/maintenance/prune/
# CRON_SECRET=

# --- キャッシュ ---------------------------------------------------------
# 使うのは二重送信の抑止だけ。指定しなければ DB の表を使う。
# worker をまたいで共有できればよいので、Redis があるならそちらが速い。
# REDIS_URL=redis://localhost:6379/0

# --- 見張り -------------------------------------------------------------
# 任意。空なら何も読み込まない。本文は送らない設定で初期化する。
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
