# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database（未設定なら SQLite）
# DATABASE_URL=postgres://user:pass@localhost:5432/aippo

# AI プロバイダ
# stub のままでもレッスンは完走できる（憲章 原則 III）
AI_PROVIDER=stub
AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# フロントエンド
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI実行回数の上限（1セッションあたり）。課金事故を防ぐため必ず設定する
MAX_ATTEMPTS_PER_SESSION=10
