# Oracle Cloud VM 用の設定。
#
#   cp .env.example .env
#
# このファイルはリポジトリに入る。実際の値を書かない。
# 鍵の作り方（50文字以上が必要）:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 必須 -----------------------------------------------------------------
DJANGO_SECRET_KEY=ここに50文字以上の乱数を入れる
POSTGRES_PASSWORD=ここにDBのパスワードを入れる

# 例）aippo-yourname.duckdns.org
BACKEND_DOMAIN=ここにバックエンドのドメインを入れる
# 証明書の期限が近づいたときの通知先（Let's Encrypt の規約上、実在のメール推奨）
ACME_EMAIL=ここに自分のメールアドレスを入れる

# 画面（Vercel）の URL。デプロイ後に確定した実際の URL に置き換えること
FRONTEND_URL=https://ここにVercelのURLを入れる
CORS_ALLOWED_ORIGINS=https://ここにVercelのURLを入れる

# --- メール ------------------------------------------------------------
# 最初はコンソール出力のままでよい（実際には送られない＝確認メール等は
# 使えないが、mock AI と組み合わせれば動作確認はできる）。
# 実際にユーザー登録を開放するなら smtp に変えて、下を埋めること。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AIPPO <no-reply@localhost>

# --- AI -------------------------------------------------------------------
# 鍵が無くても mock のままレッスンは完走できる（憲章 原則 III）。
# 本物のAIを使うときだけ、どちらかの鍵を入れる。
AI_PROVIDER=mock
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# --- DB ---------------------------------------------------------------
POSTGRES_DB=aippo
POSTGRES_USER=aippo
