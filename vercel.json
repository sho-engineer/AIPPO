{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend/",
      "framework": "django",
      "entrypoint": "config.wsgi:application",
      "functions": {
        "config/wsgi.py": {
          "maxDuration": 30
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/admin/:path*", "destination": { "service": "backend" } },
    { "source": "/static/:path*", "destination": { "service": "backend" } },
    { "source": "/health/:path*", "destination": { "service": "backend" } },
    { "source": "/healthz", "destination": { "service": "backend" } },
    { "source": "/readyz", "destination": { "service": "backend" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ]
}
